<mxfile host="app.diagrams.net">
  <diagram name="Contexto" id="contexto1">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Usuários -->
        <mxCell id="cliente" value="Cliente" style="ellipse;whiteSpace=wrap;html=1;fillColor=#cde4ff;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="120" height="60" as="geometry"/></mxCell>
