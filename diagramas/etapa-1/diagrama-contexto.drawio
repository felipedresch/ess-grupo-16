        <mxCell id="backoffice" value="Backoffice (Admin / Suporte)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="580" y="160" width="150" height="60" as="geometry"/></mxCell>

