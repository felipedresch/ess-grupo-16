        <mxCell id="bd" value="Banco de Dados" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="200" y="440" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="storage" value="Storage de Arquivos/Documentos" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="140" height="70" as="geometry"/></mxCell>

