        <mxCell id="admin" value="Administrador / Suporte" style="ellipse;whiteSpace=wrap;html=1;fillColor=#cde4ff;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="140" height="60" as="geometry"/></mxCell>

